# ==========================================================
# CASINO SCRAPER CONFIGURATION
# ==========================================================

# Public comparison page used by the scraper
SOURCE_URL=https://betproof.co.za/casino-bonuses-south-africa/

# Human-readable source name stored in casinos.json
SOURCE_NAME=BetProof South Africa Casino Bonuses


# ==========================================================
# LANGUAGE MODEL CONFIGURATION
# ==========================================================

# IMPORTANT:
# Never place your real API key in this example file.
# Copy this file to .env and enter the private key there.
LLM_API_KEY=YOUR_OPENAI_API_KEY_HERE

# OpenAI API endpoint
LLM_BASE_URL=https://api.openai.com/v1

# Language model used for structured extraction
LLM_MODEL=gpt-5-mini